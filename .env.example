# KawanSport env (root). Salin ke .env: `cp .env.example .env`
#
# DUA KONTEKS (INF-01):
# - Dev di HOST (`npm run api:dev`): DATABASE_URL/REDIS_URL di bawah memakai
#   localhost → menarget service compose yang di-publish ke host.
# - Service `api` DI DALAM compose: docker-compose.yml me-override
#   DATABASE_URL → postgres://...@db:5432/... dan REDIS_URL → redis://redis:6379
#   (hostname antar-service). Nilai localhost di file ini TIDAK dipakai container.

# --- Postgres / PostGIS (service `db`) ---
POSTGRES_USER=kawansport
POSTGRES_PASSWORD=kawansport_dev
POSTGRES_DB=kawansport
POSTGRES_PORT=5432
# Untuk dev host. Di-override compose menjadi @db:5432 untuk container api.
DATABASE_URL=postgres://kawansport:kawansport_dev@localhost:5432/kawansport

# --- Redis (service `redis`) ---
REDIS_PORT=6379
# Untuk dev host. Di-override compose menjadi redis://redis:6379 untuk container api.
REDIS_URL=redis://localhost:6379

# --- API (NestJS, service `api` + dev host) ---
# API_PORT = port HOST untuk mapping `${API_PORT}:3000`. Port internal
# container api tetap 3000 (lihat environment API_PORT di docker-compose.yml).
API_PORT=3000
API_PREFIX=
JWT_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-refresh-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Auto-sync skema TypeORM: true untuk dev/demo (compose up + seed langsung jalan).
# PROD wajib false + migrasi DB berversi (belum ada — lihat README INF-01).
TYPEORM_SYNC=true
# DB_DRIVER=postgres (default) | sqljs (in-memory, hanya untuk e2e test tanpa Postgres)
DB_DRIVER=postgres

# --- CORS (SEC-01: origin dibatasi, bukan *) ---
# Comma-separated. Default dev-friendly (CMS :3001 + landing :3002).
# PROD: ganti dengan domain asli, mis. CORS_ORIGIN=https://cms.kawansport.id
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# --- Upload avatar SM-03 (MVP local storage, diserve di /uploads/) ---
# UPLOAD_DIR relatif terhadap cwd API (default: ./uploads).
# Di container api (= /app/apps/api/uploads) di-mount sebagai named volume
# `uploadsdata` agar persist antar restart (lihat docker-compose.yml).
UPLOAD_DIR=./uploads
AVATAR_MAX_MB=2
# Nanti (MinIO/S3): ganti saveAvatarBuffer() di apps/api/src/users/upload.config.ts,
# kembalikan URL publik (S3/MinIO presigned atau public URL) tanpa ubah controller.

# --- CMS (AD-01: apps/cms sudah ada; slot compose masih commented) ---
# CMS_PORT dipakai saat slot `cms` di docker-compose.yml diaktifkan.
# Dev lokal: `npm run cms:dev` (http://localhost:3001).
CMS_PORT=3001
# LANDING_PORT=3002

# --- Midtrans sandbox (AD-01: key dipisah di env, jangan hardcode) ---
# Dipakai fase BK/MP berikutnya. Kosongkan bila belum ada key sandbox.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions

# --- Push notification via FCM HTTP v1 (PH3-08, pengganti Expo Push API) ---
# Mode stub (tanpa kredensial/jaringan): kirim hanya di-log, sent=jumlah token.
FIREBASE_STUB=true
# Produksi: salah satu wajib diisi (prioritas: inline JSON dulu).
# Isi JSON service account Firebase (satu baris) — JANGAN commit file asli.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatif: path file service account (didukung firebase-admin applicationDefault).
GOOGLE_APPLICATION_CREDENTIALS=
