# API local env (copy dari root .env.example bila perlu)
API_PORT=3000
DATABASE_URL=postgres://kawansport:kawansport_dev@localhost:5432/kawansport
# DB_DRIVER=postgres (default). Untuk e2e tanpa Postgres: DB_DRIVER=sqljs (in-memory, hanya untuk test).
DB_DRIVER=postgres
# TYPEORM_SYNC=false di production; true untuk dev agar tabel users/refresh_tokens auto-create.
TYPEORM_SYNC=true
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-refresh-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Upload avatar SM-03 (MVP local storage -> GET /uploads/avatars/<file>).
UPLOAD_DIR=./uploads
AVATAR_MAX_MB=2
# Midtrans sandbox (AD-01: key dipisah di env, JANGAN hardcode di kode).
# Payment dipakai fase BK/MP berikutnya; API hanya membaca env ini.
# Isi dari dashboard Midtrans sandbox: https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
# Push notification via FCM HTTP v1 (PH3-08, pengganti Expo Push API).
# Mode stub (tanpa kredensial/jaringan): kirim hanya di-log, sent=jumlah token.
FIREBASE_STUB=true
# Produksi: salah satu wajib diisi (prioritas: inline JSON dulu).
# Isi JSON service account Firebase (satu baris) — JANGAN commit file asli.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatif: path file service account (didukung firebase-admin applicationDefault).
GOOGLE_APPLICATION_CREDENTIALS=
