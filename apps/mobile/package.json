{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "KawanSport Mobile — React Native bare CLI + TypeScript (SM-01)",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "test": "jest",
    "tsc": "tsc --noEmit",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/kawansport-android.bundle --assets-dest /tmp/kawansport-assets"
  },
  "dependencies": {
    "@react-native-community/push-notification-ios": "^1.12.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "axios": "^1.20.0",
    "react": "18.2.0",
    "react-native": "0.73.11",
    "react-native-encrypted-storage": "^4.0.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@react-native/babel-preset": "^0.73.21",
    "@react-native/metro-config": "^0.73.5",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.4.5"
  }
}
