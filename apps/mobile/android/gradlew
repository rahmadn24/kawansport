##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a Java version compatible with the Gradle version you're
#       trying to run. That is, Java 17 for Gradle 8.3.
#
#   (2) You need to set the JAVA_HOME environment variable.
#
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a link
app_path=$0

# Need this for daemons to work
# shellcheck disable=SC2034
APP_HOME=$( cd "${APP_HOME:-$(dirname "$app_path")}" && pwd -P ) || exit

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in
  *CYGWIN* )         cygwin=true  ;;
  *Darwin* )         darwin=true  ;;
  *MSYS* | *MINGW* ) msys=true    ;;
  *NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please install the JDK."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -Hn is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        # In POSIX sh, ulimit -n is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# Collect all arguments for the wrapper script since they might contain word-splitting and quoting issues.
# shellcheck disable=SC2223
for i do
    # shellcheck disable=SC2086
    case $i in
    -Dorg.gradle.java.home=*) JAVA_HOME_ORG_GRADLE=${i#-Dorg.gradle.java.home=} ;;
    esac
done

if [ -n "$JAVA_HOME_ORG_GRADLE" ] ; then
    JAVACMD=$JAVA_HOME_ORG_GRADLE/bin/java
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: -Dorg.gradle.java.home is set to an invalid directory: $JAVA_HOME_ORG_GRADLE

    Please set the -Dorg.gradle.java.home variable in your environment to match the
    location of your Java installation."
    fi
fi

# Collect all arguments for the wrapper script since they might contain word-splitting and quoting issues.
# shellcheck disable=SC2249,SC2223
for i do
    # shellcheck disable=SC2086
    case $i in
    --add-opens|--add-exports) eval "set -- $* '$i'" ; shift ;; # keep --add-opens/exports as separate args (no quoting)
    *\"*) args="$args \"$i\"" ;; # double-quote args containing double quotes
    *\'*) args="$args '$i'" ;; # single-quote args containing single quotes
    *) args="$args \"$i\"" ;;
    esac
done

# shellcheck disable=SC2086
eval "set -- $args"

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=$APP_BASE_NAME" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
