{
  "name": "kawansport-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "KawanSport monorepo — RN bare TS + NestJS + Postgres/PostGIS + Redis (SM-01)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w apps/api",
    "api:build": "npm run build -w apps/api",
    "api:start": "npm run start:prod -w apps/api",
    "cms:dev": "npm run dev -w apps/cms",
    "cms:build": "npm run build -w apps/cms",
    "mobile:start": "npm run start -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/mobile",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db redis",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
